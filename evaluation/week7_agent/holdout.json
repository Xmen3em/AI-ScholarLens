    {
      "id": "week7-holdout-cross-training",
      "kind": "multi_paper",
      "query": "What training signal does SpeechGym use for successful tool calls, and how does TTPO train agreeing versus disagreeing rollouts?",
      "answerable": true,
      "expected_scope": "in",
      "facts": [
        {
          "id": "cross-training-speech",
          "text": "SpeechGym uses a per-turn process reward crediting each successful tool call to restore rollout-group variance."
        },
        {
          "id": "ttpo-branches-f1",
          "text": "Agreeing rollouts are distilled via on-policy self-distillation (OPSD)."
        },
        {
          "id": "ttpo-branches-f2",
          "text": "Disagreeing rollouts are penalized with Grouped RL."
        }
      ],
      "support": [
        {
          "id": "speech-reward",
          "fact_ids": [
            "cross-training-speech"
          ],
          "locators": [
            {
              "arxiv_id": "2608.26432v1",
              "section_index": 2,
              "chunk_index": 0,
              "section_title": "Abstract",
              "source_excerpt": "Outcome-only GRPO is gradient-starved here, since almost every rollout group fails identically, while a per-turn process reward crediting each successful tool call restores variance to nearly every group.",
              "chunk_sha256": "9757105ca113504b92398411b9709fb899747576d1132ab4076a59d6f5dd912b"
            }
          ]
        },
