    {
      "id": "week7-holdout-speech-failure-literal",
      "kind": "literal",
      "query": "What perceptual and behavioural failures does SpeechGym identify in voice-agent tool use?",
      "pair_id": "holdout-speech-failure",
      "answerable": true,
      "expected_scope": "in",
      "facts": [
        {
          "id": "speech-failure-f1",
          "text": "A misheard waveform value is placed in the correct tool argument slot, causing a failed call and wasted retries/steps."
        },
        {
          "id": "speech-failure-f2",
          "text": "An insistent caller can induce an unauthorised write that the agent believes is helpful."
        }
      ],
      "support": [
        {
          "id": "speech-failure",
          "fact_ids": [
            "speech-failure-f1",
            "speech-failure-f2"
          ],
          "locators": [
            {
              "arxiv_id": "2608.26432v1",
              "section_index": 2,
              "chunk_index": 0,
              "section_title": "Abstract",
              "source_excerpt": "The failures speech introduces are perceptual rather than reasoning deficits: the agent picks the right tool and the right argument slot but fills it with a value misheard from the waveform, and that single error cascades into a failed call, a retry of the same call, and a wasted step budget. A second failure is behavioural: under an insistent caller the agent performs an unauthorised write and ends the episode believing it helped.",
              "chunk_sha256": "9757105ca113504b92398411b9709fb899747576d1132ab4076a59d6f5dd912b"
            }
          ]
        }
      ]
    },
