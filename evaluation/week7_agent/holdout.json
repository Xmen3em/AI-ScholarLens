    {
      "id": "week7-holdout-ttpo-branches-literal",
      "kind": "literal",
      "query": "How does TTPO update agreeing and disagreeing rollouts?",
      "pair_id": "holdout-ttpo-branches",
      "answerable": true,
      "expected_scope": "in",
      "facts": [
        {
          "id": "ttpo-branches-f1",
          "text": "Agreeing rollouts are distilled via on-policy self-distillation (OPSD)."
        },
        {
          "id": "ttpo-branches-f2",
          "text": "Disagreeing rollouts are penalized with Grouped RL."
        }
      ],
      "support": [
        {
