# Loaded into the environment by pytest-dotenv (see env_files in pyproject.toml).
#
# Its job is isolation: environment variables outrank the .env file in
# pydantic-settings, so these values shield the suite from whatever a developer
# happens to have in their own .env. Without it, a stray TIMEOUT_SECONDS or
# OLLAMA_MODELS on the machine changes what the tests exercise.
#
# Keep every setting the suite can construct listed here, with fixed values.

APP_VERSION=0.0.0-test
DEBUG=false
ENVIRONMENT=test
API_KEY=
API_REQUESTS_PER_MINUTE=60
API_GENERATIONS_PER_MINUTE=6
API_RATE_LIMIT_PATH=./test_output/test-rate-limits.sqlite3
LOCAL_TRACING_ENABLED=false
LOCAL_TRACING_URL=http://127.0.0.1:3000
LOCAL_TRACING_PUBLIC_KEY=
LOCAL_TRACING_SECRET_KEY=
ANSWER_CACHE_ENABLED=false
ANSWER_CACHE_URL=redis://127.0.0.1:6380/0
ANSWER_CACHE_TTL_SECONDS=3600
AGENT_ENABLED=false
AGENT_DEADLINE_SECONDS=90
AGENT_NODE_TIMEOUT_SECONDS=30
HF_INFERENCE_ENABLED=false
HF_TOKEN=
HF_MODELS=openai/gpt-oss-120b:groq
HF_DEFAULT_MODEL=openai/gpt-oss-120b:groq
HF_TIMEOUT_SECONDS=30
MONITORING_DIRECTORY=
SERVICE_NAME=AI-ScholarLens

# Overridden by the testcontainers fixture; never connected to as written.
POSTGRES_DATABASE_URL=postgresql://test_user:test_password@localhost:5432/test_db
POSTGRES_ECHO_SQL=false
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=0

OPENSEARCH_HOST=http://localhost:9200
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODELS=llama3.2:1b
OLLAMA_DEFAULT_MODEL=llama3.2:1b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=300

ARXIV__BASE_URL=https://export.arxiv.org/api/query
ARXIV__PDF_CACHE_DIR=./test_output/arxiv_pdfs
# Zero, so tests never sleep out a real rate-limit delay.
ARXIV__RATE_LIMIT_DELAY=0.0
ARXIV__TIMEOUT_SECONDS=30
ARXIV__MAX_RESULTS=10

PDF_PARSER__MAX_PAGES=45
PDF_PARSER__MAX_FILE_SIZE_MB=20
PDF_PARSER__DO_OCR=false
PDF_PARSER__DO_TABLE_STRUCTURE=false

RAG_SENTENCE_CANDIDATES_PER_PASSAGE=1
RAG_MAX_SENTENCE_CANDIDATES=

# Shield standalone bot tests from any developer's private Telegram settings.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
TELEGRAM_API_BASE_URL=http://127.0.0.1:8000/api/v1
TELEGRAM_OFFSET_PATH=./data/telegram/offset.json
