# Copy to .env and adjust. Every value below is the in-code default, so an empty
# .env works for local development; .env is gitignored, this template is not.
#
# Docker Compose does not read .env — it sets the container environment inline in
# compose.yml. This file is for running the API or tooling on the host.

# --- Application ---
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development
SERVICE_NAME=AI-ScholarLens

# --- PostgreSQL ---
# Inside Compose the host is `postgres`, not `localhost`.
POSTGRES_DATABASE_URL=postgresql://rag_user:rag_password@localhost:5432/rag_db
POSTGRES_ECHO_SQL=false
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=0

# --- OpenSearch (indexing not implemented yet) ---
OPENSEARCH_HOST=http://localhost:9200

# --- Ollama ---
OLLAMA_HOST=http://localhost:11434
# Comma-separated, not JSON.
OLLAMA_MODELS=llama3.2:1b
OLLAMA_DEFAULT_MODEL=llama3.2:1b
OLLAMA_TIMEOUT=300

# --- arXiv ingestion ---
# Nested settings use a double underscore (see env_nested_delimiter in src/config.py).
# The eight AI categories ingested are fixed in src/policies/ai_scope.py and are NOT
# configurable; ARXIV__SEARCH_CATEGORY no longer exists and is ignored if present.
ARXIV__BASE_URL=https://export.arxiv.org/api/query
ARXIV__PDF_CACHE_DIR=./data/arxiv_pdfs
# arXiv asks for 3 seconds between requests.
ARXIV__RATE_LIMIT_DELAY=3.0
ARXIV__TIMEOUT_SECONDS=30
# Papers per ingestion run, totalled across all eight categories.
ARXIV__MAX_RESULTS=10

# --- PDF parsing (Docling; runs in the Airflow image only) ---
PDF_PARSER__MAX_PAGES=45
PDF_PARSER__MAX_FILE_SIZE_MB=20
PDF_PARSER__DO_OCR=false
PDF_PARSER__DO_TABLE_STRUCTURE=false
