# Normalize line endings across platforms.
# Shell scripts MUST stay LF or they break inside Linux containers
# (a CRLF shebang -> "exec /entrypoint.sh: no such file or directory").
* text=auto eol=lf
*.sh text eol=lf
entrypoint.sh text eol=lf

# Binary assets: never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary

# Frozen evaluation and provider metadata are verified by exact byte hashes.
# Preserve their existing bytes in commits and subsequent checkouts.
evaluation/week7_agent/** -text -eol whitespace=trailing-space,space-before-tab,cr-at-eol
evaluation/week7_hf/** -text -eol whitespace=trailing-space,space-before-tab,cr-at-eol
docs/research/hf-inference-models-20261013.json -text -eol whitespace=trailing-space,space-before-tab,cr-at-eol
